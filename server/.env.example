# ─────────────────────────────────────────────────────────────
# BuildFlow API — copy to `.env` and adjust.
# Everything here has a working default except JWT_SECRET in production.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Where the browser app is served from (used for CORS + password-reset links)
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────
# `sqlite`   → zero-config local file, nothing to install. Default.
# `postgres` → the production target; set DATABASE_URL below.
DB_DRIVER=sqlite
SQLITE_PATH=buildflow.db

# Used only when DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/buildflow
# PGSSL=false

# Log every SQL statement (noisy — handy when debugging queries)
DB_LOGGING=false

# ── Auth ────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION. The server refuses to boot with the
# default value when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── AI ──────────────────────────────────────────────────────
# Optional. Without a key BuildFlow uses its built-in offline planning
# engine, so every AI feature still works — it just isn't Claude.
# Server-side only: this value is never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
AI_PLANNING_MODEL=claude-opus-5
AI_CHAT_MODEL=claude-sonnet-5

# Force the offline engine even when a key is present (useful for demos)
AI_FORCE_OFFLINE=false

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=15
